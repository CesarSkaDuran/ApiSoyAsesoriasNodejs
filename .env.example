NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soyasesorias_db
DB_USER=root
DB_PASSWORD=

# Pool de conexiones MySQL (picos de carga)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=30000

# BD vieja (solo lectura, para migracion de datos)
LEGACY_DB_NAME=soyaseso_bd

JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_DAYS=30

# Token del formulario publico (ventas/ingest) — generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOY_LEADS_TOKEN=
INGEST_RATE_WINDOW_MS=60000
INGEST_RATE_MAX=10

STORAGE_DIR=storage/documentos
